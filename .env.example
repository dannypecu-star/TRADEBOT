# Copy to .env and fill in ONLY what you use. .env is gitignored — never commit real keys.
# The bot reads all secrets from the environment, never from config.yaml.

# --- Exchange (only needed for LIVE trading via this bot; public data needs no key) ---
TRADEBOT_API_KEY=
TRADEBOT_API_SECRET=

# --- 3Commas (only if you dispatch signals to a 3Commas bot) ---
THREECOMMAS_BOT_ID=
THREECOMMAS_MESSAGE_TOKEN=
# THREECOMMAS_WEBHOOK_URL defaults to the public TradingView signal endpoint.
# THREECOMMAS_EMAIL_TOKEN=

# --- Cryptohopper (only if you dispatch signals to a hopper) ---
CRYPTOHOPPER_WEBHOOK_URL=
CRYPTOHOPPER_API_TOKEN=
CRYPTOHOPPER_HOPPER_ID=

# --- MetaTrader 5 (only if you drive an MT5 terminal from Python, Windows) ---
MT5_LOGIN=
MT5_SERVER=
